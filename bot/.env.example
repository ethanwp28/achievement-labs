# Copy to .env and fill in. Never commit .env.
#
# Bot token from https://discord.com/developers/applications -> your app -> Bot
DISCORD_TOKEN=

# Application ID from the same page ("General Information" -> Application ID)
DISCORD_CLIENT_ID=

# The server's ID (enable Developer Mode in Discord, right-click the server -> Copy Server ID).
# Commands register instantly when scoped to one guild.
DISCORD_GUILD_ID=
